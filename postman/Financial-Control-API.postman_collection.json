          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/profiles/{{profileId}}",
            "description": "id do profile = usuarioId (seed: 1)."
          }
        },
        {
          "name": "PUT profile",
          "request": {
            "method": "PUT",

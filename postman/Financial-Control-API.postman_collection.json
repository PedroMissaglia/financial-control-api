              "raw": "{\n  \"id\": \"{{profileId}}\",\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"theme\": \"cyan\",\n  \"themeMode\": \"dark\",\n  \"metaEconomia\": 1000,\n  \"alertaGastos\": 2500,\n  \"transacoesPageSize\": 10,\n  \"extratoLimite\": 10,\n  \"transacoesFiltros\": {\n    \"busca\": \"\",\n    \"tipo\": \"\",\n    \"categoria\": \"\",\n    \"dataInicio\": \"\",\n    \"dataFim\": \"\",\n    \"valorMin\": null,\n    \"valorMax\": null\n  }\n}"
            },
            "url": "{{baseUrl}}/profiles/{{profileId}}"
          }
        },
        {
          "name": "POST profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"novo-usuario-id\",\n  \"usuarioId\": \"novo-usuario-id\",\n  \"theme\": \"cyan\",\n  \"themeMode\": \"light\",\n  \"metaEconomia\": 800,\n  \"alertaGastos\": 2500,\n  \"transacoesPageSize\": 8,\n  \"extratoLimite\": 10,\n  \"transacoesFiltros\": {\n    \"busca\": \"\",\n    \"tipo\": \"\",\n    \"categoria\": \"\",\n    \"dataInicio\": \"\",\n    \"dataFim\": \"\",\n    \"valorMin\": null,\n    \"valorMax\": null\n  },\n  \"widgets\": [],\n  \"layoutRows\": [],\n  \"layoutGroups\": []\n}"
            },
            "url": "{{baseUrl}}/profiles",
